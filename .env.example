# Copy this file to .env for local development. On Coolify, add these
# under the app's Environment Variables instead (never commit real keys).

# PostgreSQL connection string. Needed for the menu, cart and checkout.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/bianco

# Stripe (optional, only for online payments). Use keys from the same Stripe account.
VITE_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional. Server port (default 3000). Leave unset on Coolify.
# PORT=3000
